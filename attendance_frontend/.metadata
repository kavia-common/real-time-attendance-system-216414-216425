# This file is used by Flutter to determine the project root and tooling versions.
# It is safe to commit to source control.

version:
  revision: "unknown"
  channel: "stable"

project_type: app

migration:
  platforms:
    - android
    - ios
    - linux
    - macos
    - web
    - windows
  unmanaged_files:
    - "android/local.properties"
    - "ios/Runner/GeneratedPluginRegistrant.*"
    - "macos/Flutter/GeneratedPluginRegistrant.*"
