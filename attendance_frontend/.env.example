# Rename this file to `.env` and set your backend base URL.
# Ensure pubspec.yaml includes `.env` under flutter assets (already configured).

# Example for Android emulator (host machine localhost via 10.0.2.2):
# BACKEND_BASE_URL=http://10.0.2.2:8000

# Example for local device on same network:
# BACKEND_BASE_URL=http://192.168.1.100:8000

BACKEND_BASE_URL=http://localhost:8000
